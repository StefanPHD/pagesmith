# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Ablage des Browser-Werkzeugs (Playwright-MCP). Entsteht UNGEFRAGT im
# Arbeitsverzeichnis beim ersten Aufruf — Seiten-Snapshots und Konsolen-Logs.
.playwright-mcp/
# Zwischendateien der Zusammenfuehrungs-Maschinerie von Git. Entstehen UNGEFRAGT
# im Arbeitsverzeichnis, u.a. bei einem stash-Rundlauf — je eine Kopie der
# beruehrten Datei, untracked und beliebig gross.
.merge_file_*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Beispiel-Datei MIT committen (enthaelt nur leere Variablennamen, keine Keys)
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
