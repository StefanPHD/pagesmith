# Supabase — Werte aus dem Supabase-Dashboard (Project Settings -> API).
# Echte Werte gehoeren NUR in .env.local (gitignored), NIEMALS in diese Datei
# oder ins Repo.

# Beide NEXT_PUBLIC-Keys sind fuer den Browser bestimmt und durch RLS abgesichert.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role-Key (Scheibe 2a): GEHEIM, bypassed RLS. NUR server-only genutzt
# (src/lib/supabase/admin.ts, import "server-only"). NON-NEXT_PUBLIC -> landet nie
# im Client-Bundle. NIEMALS in eine Client-Komponente oder in den Export.
SUPABASE_SERVICE_ROLE_KEY=

# App-URL (Scheibe 2b-ii): OEFFENTLICH (kein Secret). Wird in den Export gebacken —
# der Client-Beacon (sendBeacon) zielt auf ${NEXT_PUBLIC_APP_URL}/api/capi. Muss
# ABSOLUT sein, weil der Export auf fremder Domain laeuft. Dev: http://localhost:3000;
# Prod: die Pagesmith-Domain (im Vercel-Project-Env setzen). Fehlt/leer -> KEIN Beacon
# + console.warn (fail-loud, kein relativer Fallback).
NEXT_PUBLIC_APP_URL=

# Serving-Basis-Domain (Phase 7): Basis der Live-URL publizierter Projekte
# (<label>.<domain>). OEFFENTLICH, kein Secret; wird build-zeit ins Client-Bundle
# inlined. Ohne Protokoll, ohne trailing slash — https wird automatisch abgeleitet
# (Ausnahme: localhost / *.lvh.me -> http). Leer in Prod -> publizierte Projekte
# erhalten keine Live-URL (fail-loud console.warn beim Publish).
NEXT_PUBLIC_HOSTING_DOMAIN=lvh.me:3000  # Dev. Prod: publayer.net (ohne Port)

# Abuse-Kontakt (Kill-Switch, Security-Manifest Tier 0): erscheint als Kontaktzeile auf
# der 451-Erklaerseite eines gesperrten Projekts. BEWUSST LEER, solange das Projekt in
# geschlossener Entwicklung ist und publayer.net keine MX-Records hat (eine Adresse waere
# heute tot). Leer/ungesetzt/nur-Whitespace -> die Kontaktzeile entfaellt komplett
# (getrimmt). BEIM LIVE-GANG befuellen (Launch-Blocker "Abuse-Kanal", sobald MX steht).
NEXT_PUBLIC_ABUSE_CONTACT=

# Chiffrier-Schluessel der Autorisierungsschicht (Phase 11.8, Scheibe 11.8a):
# GEHEIM, NON-NEXT_PUBLIC -> landet nie im Client-Bundle. NUR server-only genutzt
# (src/lib/secrets/cipher.ts, import "server-only").
# FORM: "<kennung>:<32 Byte, base64>", mehrere durch Komma getrennt. MEHRERE
# Eintraege sind Absicht: Alt und Neu liegen bei einem Schluesselwechsel
# nebeneinander, jedes Chiffrat nennt selbst die Kennung, die es braucht.
# DIE KENNUNG: nur [a-z0-9_-], hoechstens 32 Zeichen, NIE ein Punkt (der trennt die
# fuenf Teile des Chiffrats).
# HARTE REGEL, die jede spaetere Runde bindet: EINE KENNUNG WIRD NIE FUER EINEN
# ANDEREN SCHLUESSELWERT WIEDERVERWENDET. Ein neuer Schluessel bekommt eine NEUE
# Kennung; der alte bleibt zum Lesen stehen, bis nichts mehr unter ihm liegt.
# PRODUKTION UND ENTWICKLUNG TRAGEN VERSCHIEDENE WERTE **UND** VERSCHIEDENE
# KENNUNGEN (z.B. dev-1 hier, prod-1 im Vercel-Project-Env). Dann nennt ein
# Produktions-Chiffrat hier eine unbekannte Kennung -> lauter Abbruch (unknown_key)
# statt eines Fehlschlags, der wie eine Manipulation aussieht.
# Fehlt/leer -> no_key; vorhanden aber unbrauchbar -> bad_key. Es gibt KEINEN
# stillen Ersatzwert.
SECRET_ENC_KEYS=
# Die Kennung, unter der NEUE Chiffrate entstehen. Muss in SECRET_ENC_KEYS stehen.
SECRET_ENC_ACTIVE_KEY_ID=

# Google-OAuth-Client der Autorisierungsschicht (Phase 11.8): das Client-Paar und die
# Weiterleitungs-Adresse des OAuth-Clients im Cloud-Projekt "Tracking-OAuth-Dev"
# (Typ WEBANWENDUNG). Herkunft, Begruendung und Auflagen: docs/roadmap.md,
# Eintrag 11.8, Block vom 2026-08-27.
# ALLE DREI OHNE NEXT_PUBLIC_ — auch die CLIENT_ID, die kein Geheimnis ist: der Server
# baut die Autorisierungs-URL, im Client wird kein Wert gebraucht, und ein
# NEXT_PUBLIC_-Wert wuerde bei jeder Aenderung einen Redeploy erzwingen.
# GOOGLE_OAUTH_ und nicht GOOGLE_DATAMANAGER_: der Client haengt am CLOUD-PROJEKT,
# nicht an der API. Bekommt ein spaeteres Vorhaben ein EIGENES Cloud-Projekt, ist der
# Name zu unspezifisch und umzubenennen.
GOOGLE_OAUTH_CLIENT_ID=

# GEHEIM, NON-NEXT_PUBLIC. ANWENDUNGS-Geheimnis: eines fuer ALLE Kunden, Klasse
# SUPABASE_SERVICE_ROLE_KEY. Gehoert ausdruecklich NICHT nach project_secrets und wird
# NICHT ueber src/lib/secrets/cipher.ts abgelegt — dort liegen KUNDEN-Zugangsdaten, und
# der Chiffrier-Schluessel laege daneben.
GOOGLE_OAUTH_CLIENT_SECRET=

# JE UMGEBUNG EIN ANDERER WERT: lokal die localhost-Zeile, in Vercel die Zeile der
# stabilen Deployment-Adresse (dort im Vercel-Project-Env setzen, nicht hier).
# Der Wert muss in der Google-Cloud-Konsole REGISTRIERT sein; der Anbieter gleicht
# ZEICHENGENAU ab — Schema woertlich, Pfad woertlich, KEIN abschliessender Schraegstrich.
# DIE ZWEI REGISTRIERTEN ADRESSEN STEHEN ZEICHENGENAU IN docs/roadmap.md, Eintrag 11.8,
# Block vom 2026-08-27, und werden hier BEWUSST NICHT verdoppelt: zwei Fassungen einer
# zeichengenauen Angabe laufen auseinander, und die Abweichung faellt an keinem Gate auf.
# Vorschau-Deployments tragen eine eigene Adresse und sind nicht registriert.
GOOGLE_OAUTH_REDIRECT_URI=
